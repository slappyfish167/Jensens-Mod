  {
   "id": "hira_a",
   "title": "Hiragana: あ い う え お",
   "stage": "hiragana",
   "intro": "Japanese has three scripts. Hiragana comes first: every sound in the language can be written with it. We start with the five vowels.",
   "items": [
    "h_a",
    "h_i",
    "h_u",
    "h_e",
    "h_o"
   ]
  },
  {
   "id": "hira_ka",
   "title": "Hiragana: か row",
   "stage": "hiragana",
